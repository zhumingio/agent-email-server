# ============ zmail 环境配置 ============
# 监听地址与端口（容器内部）
HOST=0.0.0.0
PORT=3000

# 数据目录（SQLite + 加密令牌落盘）
DATA_DIR=/data

# 对外公开的访问地址（OAuth 回调 redirect_uri 会基于它拼接）
# 部署到 mail.example.com 时设为 https://mail.example.com
ZMAIL_PUBLIC_BASE_URL=https://mail.example.com

# 主 API Key（Web 与 MCP 共用 Bearer 鉴权）
# 不设置则首次启动自动生成并持久化，可在设置页查看/重新生成
# ZMAIL_API_TOKEN=

# 加密密钥（用于加密存储 OAuth 令牌/授权码），不设置则自动生成并持久化
# ZMAIL_MASTER_KEY=

# ---- Gmail OAuth2（Google Cloud Console 创建 OAuth 客户端）----
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=

# ---- Outlook OAuth2（Microsoft Entra 应用注册）----
# OUTLOOK_OAUTH_CLIENT_ID=
# OUTLOOK_OAUTH_CLIENT_SECRET=
