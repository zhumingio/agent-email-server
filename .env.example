# ============ zmail 环境配置 ============
# 监听地址与端口（容器内部）
HOST=0.0.0.0
PORT=3000

# 数据目录（SQLite + 加密令牌落盘）
DATA_DIR=/data

# 对外公开的访问地址（OAuth 回调 redirect_uri 与前端链接基于它拼接）
# 必须与浏览器实际访问地址完全一致（含端口），例如 https://mail.example.com:22345
ZMAIL_PUBLIC_BASE_URL=https://mail.example.com:22345

# ---- nginx / 证书 ----
# 证书域名（nginx HTTPS server_name 与 :80 跳转目标）
ZMAIL_DOMAIN=mail.example.com
# HTTPS 对外端口（compose 默认映射 22345:443）
ZMAIL_HTTPS_PORT=22345
# ACME 证书申请的邮箱（可选，供 scripts/issue-cert.sh 读取）
# ACME_EMAIL=you@example.com

# ---- 跨域白名单 ----
# 浏览器同源访问无需配置；App（Tauri/Capacitor）默认来源已内置。
# 如需额外允许的 Web 来源，用逗号分隔精确 origin（不要带结尾斜杠）；* 表示不限制（不推荐）
# ZMAIL_ALLOWED_ORIGINS=https://other.example.com

# 主 API Key（Web 与 MCP 共用 Bearer 鉴权）
# 不设置则首次启动自动生成并持久化，可在设置页查看/重新生成
# ZMAIL_API_TOKEN=

# 加密密钥（用于加密存储 OAuth 令牌/授权码），不设置则自动生成并持久化
# ZMAIL_MASTER_KEY=

# ---- Gmail OAuth2（Google Cloud Console 创建 OAuth 客户端）----
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=

# ---- Outlook OAuth2（Microsoft Entra 应用注册）----
# OUTLOOK_OAUTH_CLIENT_ID=
# OUTLOOK_OAUTH_CLIENT_SECRET=
